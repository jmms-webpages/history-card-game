rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helper functions -----------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Must stay in sync with ALLOWED_EMAIL_DOMAINS in AuthContext.tsx.
    function isAllowedEmailDomain(email) {
      return email != null && (
        email.matches('.*@bearworks[.]jackson[.]sparcc[.]org$') ||
        email.matches('.*@jackson[.]sparcc[.]org$')
      );
    }

    // Must stay in sync with ADMIN_EMAILS in AuthContext.tsx. Exact-match
    // ONLY -- never prefix/substring matching -- so this can't be spoofed
    // by an email like "jaf2jc@example.com".
    function isDesignatedAdminEmail(email) {
      return email != null && (
        email == 'jaf2jc@bearworks.jackson.sparcc.org' ||
        email == 'jaf2jc@jackson.sparcc.org'
      );
    }

    // Firestore rules can't call into Cloud Functions on the Spark (free)
    // plan, so there is no fully server-authoritative way to verify a coin
    // change came from a real trivia answer / pack purchase / card sale.
    // As defense in depth, this at least blocks a single crafted write from
    // setting coins to an arbitrary value: any write that touches `coins`
    // must change it by exactly one of the amounts the game actually pays
    // out or charges. MUST be kept in sync with DEFAULT_GAME_SETTINGS in
    // data/initialCurriculum.ts if those values ever change.
    function isAllowedCoinDelta(delta) {
      return delta in [
        -100,  // standardPackCost
        10,    // correctCoinReward
        3,     // incorrectCoinReward
        5,     // duplicateSellValues.Common
        15,    // duplicateSellValues.Uncommon
        40,    // duplicateSellValues.Rare
        150,   // duplicateSellValues.Legendary
        500    // duplicateSellValues.Mythical
      ];
    }

    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      // Only the profile owner or an admin/teacher may read a profile.
      // Classmates never see each other's Firestore user documents
      // (which contain email) -- trading UI only ever shows safe,
      // separately-curated peer data.
      allow read: if isOwner(userId) || isAdmin();

      // A user may only ever create THEIR OWN profile document, using the
      // email on their verified Firebase Auth token (not client-supplied
      // data), restricted to district Google accounts. Only the exact
      // designated admin email(s) may create themselves with role
      // 'admin' -- every other account is forced to start as 'student'.
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.email == request.auth.token.email &&
        isAllowedEmailDomain(request.resource.data.email) &&
        request.resource.data.coins >= 0 &&
        (
          (isDesignatedAdminEmail(request.auth.token.email) && request.resource.data.role == 'admin') ||
          (!isDesignatedAdminEmail(request.auth.token.email) && request.resource.data.role == 'student')
        );

      // Users can update safe profile fields (avatar, classroomCode,
      // lastLoginAt, coins). role, displayName, and email can NEVER be
      // changed by the user themself -- only an admin can change them
      // (e.g. to promote a 'teacher'). If the write touches `coins`, the
      // change must match a real in-game reward/cost amount (see
      // isAllowedCoinDelta) -- this stops a single crafted write from
      // setting coins to an arbitrary number, even though it can't fully
      // verify the underlying gameplay action without a paid Functions plan.
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'displayName', 'email']) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coins']) ||
          isAllowedCoinDelta(request.resource.data.coins - resource.data.coins)
        ) &&
        request.resource.data.coins >= 0
      );
      allow delete: if isAdmin();

      // Daily activity subcollection
      match /dailyActivity/{date} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      // Inventory subcollection. Items can be created (pack pull) or
      // deleted (selling a duplicate) by their owner, but never silently
      // rewritten in place -- that would let a client swap a common card's
      // ID for a rare one after the fact without ever "drawing" it.
      match /inventory/{instanceId} {
        allow read: if isOwner(userId) || isAdmin();
allow create: if (isOwner(userId) || isAdmin()) &&
          request.resource.data.keys().hasOnly(['instanceId', 'cardId', 'obtainedAt', 'isDuplicate', 'isHolo']) &&
          request.resource.data.instanceId is string &&
          request.resource.data.cardId is string &&
          request.resource.data.isDuplicate is bool &&
          (!request.resource.data.keys().hasAny(['isHolo']) || request.resource.data.isHolo is bool);
        allow delete: if isOwner(userId) || isAdmin();
        allow update: if isAdmin();
      }
    }

    // Public, safe-fields-only leaderboard entry per student. Deliberately
    // separate from /users/{userId} so classmates can see rankings without
    // ever being able to read each other's email address.
    match /leaderboard/{uid} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || (
        isOwner(uid) &&
        request.resource.data.uid == uid &&
        !request.resource.data.keys().hasAny(['email'])
      );
      allow delete: if isAdmin();
    }

    // Content: Questions, Cards, Packs, Units, Standards
    match /questions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /cards/{cardId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /packs/{packId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /units/{unitId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /standards/{standardId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Game settings
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Note: the /trades collection has been intentionally removed along
    // with the peer-trading feature. If it's ever reintroduced, it needs
    // its own rules again -- Firestore denies access to any path with no
    // matching rule by default.
  }
}
